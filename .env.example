# Copy to .env and fill in. Never commit real values.
# Sections: Database / Sources / Auth / Other.

# ===========================================================================
# Database
# ===========================================================================

# --- Local MySQL container (docker-compose.yml) -----------------------------
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app_dev

# --- Which database (lib/databaseUrl.ts) ------------------------------------
# .env holds both sets of URLs side by side, and this one flag picks the set:
#   local  -> the LOCAL_DATABASE_URL* vars (also when DB_TARGET is unset or empty)
#   oracle -> the ORACLE_DATABASE_URL* vars
# Any other value is an error. lib/databaseUrl.ts is the only code that reads
# these vars (ESLint and lib/databaseUrlGuard.test.ts enforce it), and
# Prisma's CLI (prisma7.config.ts: `prisma migrate deploy` and friends)
# follows the same flag. Switching database means changing DB_TARGET only.
# Agents never set DB_TARGET=oracle: Oracle runs are the user's.
DB_TARGET=local

# --- Credential scoping -----------------------------------------------------
# Each set has three connection strings, each scoped to the minimum
# privilege its callers actually need — see docs/field-mapping.md's
# "Credential scoping" section for the full call-site list. On Oracle
# HeatWave they're three real, separately-scoped MySQL users: bg_db_rw,
# bg_db_ro and bg_db_app.
#
#   *_DATABASE_URL           read-write / admin (bg_db_rw on Oracle:
#                            SELECT/INSERT/UPDATE/DELETE/CREATE/ALTER/INDEX/
#                            REFERENCES on the backgammon database). The
#                            `prisma` client: ingest (lib/ingest.ts), sync
#                            (lib/sync.ts, scripts/sync/backfill.ts,
#                            scripts/sync/incremental-sync.ts,
#                            /api/sync/incremental), and `prisma migrate
#                            deploy` itself (prisma7.config.ts), since schema
#                            changes need CREATE/ALTER beyond plain app
#                            read-write. Don't narrow it to a lower-privilege
#                            user; migrations need the full grant list.
#                            Never set on Vercel.
#   *_DATABASE_URL_READONLY  read-only (bg_db_ro: SELECT only). The
#                            `prismaReadOnly` client: anything that only ever
#                            queries — lib/local-client.ts (the /matches
#                            DB-backed read path), app/api/player-identities,
#                            app/status, read-only diagnostic scripts; never
#                            ingest/sync/migration code.
#                            scripts/readonly/ro-query.ts requires it to be
#                            bg_db_ro (its --target picks the set).
#   *_DATABASE_URL_APP       every in-app write (bg_db_app; grants in
#                            scripts/db/sql/app-db-user.sql). The `prismaApp`
#                            client: the forum (posts, replies, attached
#                            positions, move proposals), decision notes, tags,
#                            review cards and logs, and AppUser provisioning
#                            at sign-in. Setting it also turns app writes on
#                            (lib/appWriteGate.ts) without enabling Galaxy or
#                            sync. Optional locally: when it's unset, local
#                            development falls back to the read-write URL (and
#                            app writes follow ENABLE_WRITE_MODE); production
#                            does not. Under AUTH_BYPASS it must be localhost.
#
# Local mirrors the split. docker-compose.yml itself only creates the "app"
# user (ALL PRIVILEGES on MYSQL_DATABASE), which is what the defaults below
# use so a fresh checkout works out of the box. The existing local container
# also has bg_db_rw and bg_db_ro, created by hand (there's no init script for
# them in the repo), with the same grant shapes as production on both local
# schemas:
#   bg_db_rw: SELECT, INSERT, UPDATE, DELETE, CREATE, REFERENCES, INDEX, ALTER
#             ON app_dev.* and bg_test.*
#   bg_db_ro: SELECT ON app_dev.* and bg_test.*
# Point LOCAL_DATABASE_URL at bg_db_rw and LOCAL_DATABASE_URL_READONLY at
# bg_db_ro (same localhost:3306/app_dev URL shape) to test the split locally.
LOCAL_DATABASE_URL="mysql://app:app@localhost:3306/app_dev"
LOCAL_DATABASE_URL_READONLY="mysql://app:app@localhost:3306/app_dev"
LOCAL_DATABASE_URL_APP=

# Oracle HeatWave: host is the HeatWave NLB's public IP, port 3306; SSL is
# required, and the `mariadb` driver needs allowPublicKeyRetrieval=true
# explicitly — both expressed as query params, e.g.:
#   mysql://bg_db_rw:<password>@<nlb-public-ip>:3306/backgammon?ssl=true&allowPublicKeyRetrieval=true
# Same host/port/SSL for all three, each with its own user (bg_db_rw,
# bg_db_ro, bg_db_app). Read only when DB_TARGET=oracle (except
# scripts/readonly/ro-query.ts --target oracle, which reads the read-only one).
ORACLE_DATABASE_URL=
ORACLE_DATABASE_URL_READONLY=
ORACLE_DATABASE_URL_APP=

# ===========================================================================
# Sources
# ===========================================================================

# --- Galaxy gate (lib/galaxyGate.ts) -----------------------------------------
# Gates Galaxy and sync only (/sources/*, /api/galaxy/*, /api/sync/*,
# /api/matches/check-existence, the navbar's Sources link) — see
# docs/deploy.md. Locally it also turns app writes on when the app URL is
# unset (lib/appWriteGate.ts). Fails closed: disabled is the default with
# this unset, and the target's read-write URL must also be present
# regardless — the flag alone is never enough. Local dev is a write-enabled
# environment (it's where syncing/ingest actually run), so it sets this
# explicitly; a production/preview deploy on Vercel should leave it unset
# rather than setting it to "false" — absence already means disabled.
ENABLE_WRITE_MODE=true

# Galaxy API bearer token, used only by the local sync scripts
# (scripts/sync/backfill.ts, scripts/sync/incremental-sync.ts) — NOT read by the app
# itself, which always takes the token from a pasted curl/header in the
# browser instead (see GameStatsProvider) and never persists it. This is
# used verbatim as the HTTP Authorization header value (lib/galaxy-client.ts
# does not add a prefix), so include the literal "Bearer " prefix:
#   GALAXY_TOKEN=Bearer eyJhbGciOi...
# Paste a fresh one before running either script; this file stays a
# placeholder, never commit a real token.
GALAXY_TOKEN=

# ===========================================================================
# Auth
# ===========================================================================

# --- Clerk authentication ----------------------------------------------------
# Invite-only owner wall. Set these in local/deployed environments, never
# commit real values. The Clerk dashboard must also disable public sign-up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Temporary local-only auth bypass (lib/localAuthBypass.ts): set to "true"
# to skip the Clerk sign-in and post to the forum as the reserved
# local-dev-owner AppUser. Off unless exactly "true". It refuses to turn on
# (and logs a warning) unless lib/databaseUrl.ts's isLocalTarget() is true:
# DB_TARGET is local and every LOCAL_* URL in use points at localhost.
# Never set it on a deployed environment.
AUTH_BYPASS=
# Who the local bypass signs in as: the owner by default, or an invited
# member with AUTH_BYPASS_ROLE=member (a separate local-dev-member AppUser,
# so the owner row isn't changed). Only read while AUTH_BYPASS is on.
AUTH_BYPASS_ROLE=

# ===========================================================================
# Other
# ===========================================================================

# --- Oracle cert-rotation check (scripts/db/check-oracle-cert.ts) ------------
# Deliberately separate from the database URLs: this script only needs the
# bare host (no credentials — it connects with a made-up user/password purely
# to test TLS verification against the pinned CA, see the script's own header
# comment). Used by .github/workflows/check-oracle-cert.yml too, as a
# repository secret of the same name there, so it never needs the real
# connection string. Same real IP as the Oracle URLs' <nlb-public-ip> above —
# never commit the real value here either.
ORACLE_DB_HOST=
