MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app_dev

# --- Database credentials (credential scoping) --------------------------
# Two separate connection strings, each scoped to the minimum privilege its
# callers actually need — see docs/field-mapping.md's "Credential scoping"
# section for the full call-site list. Locally there's only one MySQL user
# ("app", full privileges via docker-compose.yml), so both vars point at the
# same local container/user below — there's no local privilege separation
# to test against. In production (Oracle HeatWave) they're two real,
# separately-scoped MySQL users: bg_readwrite and bg_readonly.

# Read-write / admin (bg_readwrite in production: SELECT/INSERT/UPDATE/
# DELETE/CREATE/ALTER/INDEX/REFERENCES on the backgammon database). Used by
# ingest (lib/ingest.ts), sync (lib/sync.ts, scripts/backfill.ts,
# scripts/incremental-sync.ts, /api/sync/incremental) — and this is also the
# var `prisma migrate deploy` itself reads (prisma7.config.ts), since schema
# changes need CREATE/ALTER beyond plain app read-write. Don't narrow this
# one to a lower-privilege user; migrations need the full grant list above.
#
# Production (Oracle HeatWave, bg_readwrite): host is the HeatWave NLB's
# public IP, port 3306; SSL is required, and the `mariadb` driver needs
# allowPublicKeyRetrieval=true explicitly — both expressed as query params,
# e.g.:
#   mysql://bg_readwrite:<password>@<nlb-public-ip>:3306/backgammon?ssl=true&allowPublicKeyRetrieval=true
DATABASE_URL="mysql://app:app@localhost:3306/app_dev"

# Read-only (bg_readonly in production: SELECT only). Used by anything that
# only ever queries: lib/local-client.ts (the /matches DB-backed read path),
# app/api/player-identities, app/status, and any future read-only
# diagnostic/verification script — never ingest/sync/migration code.
#
# Production (Oracle HeatWave, bg_readonly): same host/port/SSL requirements
# as DATABASE_URL above, different (read-only) credentials, e.g.:
#   mysql://bg_readonly:<password>@<nlb-public-ip>:3306/backgammon?ssl=true&allowPublicKeyRetrieval=true
DATABASE_URL_READONLY="mysql://app:app@localhost:3306/app_dev"

# Galaxy API bearer token, used only by the local sync scripts
# (scripts/backfill.ts, scripts/incremental-sync.ts) — NOT read by the app
# itself, which always takes the token from a pasted curl/header in the
# browser instead (see GameStatsProvider) and never persists it. This is
# used verbatim as the HTTP Authorization header value (lib/galaxy-client.ts
# does not add a prefix), so include the literal "Bearer " prefix:
#   GALAXY_TOKEN=Bearer eyJhbGciOi...
# Paste a fresh one before running either script; this file stays a
# placeholder, never commit a real token.
GALAXY_TOKEN=
