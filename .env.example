MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app_dev

# Host-side connection string used by Prisma. Matches the values above;
# "localhost" is correct here because the app runs on the host and connects
# to the container's published port (see docker-compose.yml).
DATABASE_URL="mysql://app:app@localhost:3306/app_dev"

# Galaxy API bearer token, used only by the local sync scripts
# (scripts/backfill.ts, scripts/incremental-sync.ts) — NOT read by the app
# itself, which always takes the token from a pasted curl/header in the
# browser instead (see GameStatsProvider) and never persists it. This is
# used verbatim as the HTTP Authorization header value (lib/galaxy-client.ts
# does not add a prefix), so include the literal "Bearer " prefix:
#   GALAXY_TOKEN=Bearer eyJhbGciOi...
# Paste a fresh one before running either script; this file stays a
# placeholder, never commit a real token.
GALAXY_TOKEN=
