MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app_dev

# --- Database credentials (credential scoping) --------------------------
# Two separate connection strings, each scoped to the minimum privilege its
# callers actually need — see docs/field-mapping.md's "Credential scoping"
# section for the full call-site list. In production (Oracle HeatWave)
# they're two real, separately-scoped MySQL users: bg_db_rw and bg_db_ro.
#
# Local mirrors that split. docker-compose.yml itself only creates the
# "app" user (ALL PRIVILEGES on MYSQL_DATABASE), which is what the defaults
# below use so a fresh checkout works out of the box. The existing local
# container also has bg_db_rw and bg_db_ro, created by hand (there's no init
# script for them in the repo), with the same grant shapes as production on
# both local schemas:
#   bg_db_rw: SELECT, INSERT, UPDATE, DELETE, CREATE, REFERENCES, INDEX, ALTER
#             ON app_dev.* and bg_test.*
#   bg_db_ro: SELECT ON app_dev.* and bg_test.*
# Point DATABASE_URL at bg_db_rw and DATABASE_URL_READONLY at bg_db_ro
# (same localhost:3306/app_dev URL shape) to test the split locally.
# scripts/ro-query.ts requires DATABASE_URL_READONLY to be bg_db_ro.

# Read-write / admin (bg_db_rw in production: SELECT/INSERT/UPDATE/
# DELETE/CREATE/ALTER/INDEX/REFERENCES on the backgammon database). Used by
# ingest (lib/ingest.ts), sync (lib/sync.ts, scripts/backfill.ts,
# scripts/incremental-sync.ts, /api/sync/incremental) — and this is also the
# var `prisma migrate deploy` itself reads (prisma7.config.ts), since schema
# changes need CREATE/ALTER beyond plain app read-write. Don't narrow this
# one to a lower-privilege user; migrations need the full grant list above.
#
# Production (Oracle HeatWave, bg_db_rw): host is the HeatWave NLB's
# public IP, port 3306; SSL is required, and the `mariadb` driver needs
# allowPublicKeyRetrieval=true explicitly — both expressed as query params,
# e.g.:
#   mysql://bg_db_rw:<password>@<nlb-public-ip>:3306/backgammon?ssl=true&allowPublicKeyRetrieval=true
DATABASE_URL="mysql://app:app@localhost:3306/app_dev"

# Read-only (bg_db_ro in production: SELECT only). Used by anything that
# only ever queries: lib/local-client.ts (the /matches DB-backed read path),
# app/api/player-identities, app/status, and any future read-only
# diagnostic/verification script — never ingest/sync/migration code.
#
# Production (Oracle HeatWave, bg_db_ro): same host/port/SSL requirements
# as DATABASE_URL above, different (read-only) credentials, e.g.:
#   mysql://bg_db_ro:<password>@<nlb-public-ip>:3306/backgammon?ssl=true&allowPublicKeyRetrieval=true
DATABASE_URL_READONLY="mysql://app:app@localhost:3306/app_dev"

# --- Galaxy gate (lib/galaxyGate.ts) -------------------------------------
# Temporary stopgap gating everything that writes to the DB or handles a
# Galaxy bearer token (/sources/*, /api/galaxy/*, /api/sync/*, the home-page
# Galaxy link) — see docs/deploy.md. Fails closed: disabled is the default
# with this unset, and DATABASE_URL must also be present regardless — the
# flag alone is never enough. Local dev is a write-enabled environment (it's
# where syncing/ingest actually run), so it sets this explicitly; a
# production/preview deploy on Vercel should leave it unset rather than
# setting it to "false" — absence already means disabled.
ENABLE_WRITE_MODE=true

# --- Oracle cert-rotation check (scripts/check-oracle-cert.ts) ----------
# Deliberately separate from DATABASE_URL: this script only needs the bare
# host (no credentials — it connects with a made-up user/password purely to
# test TLS verification against the pinned CA, see the script's own header
# comment). Used by .github/workflows/check-oracle-cert.yml too, as a
# repository secret of the same name there, so it never needs the real
# connection string. Same real IP as DATABASE_URL's <nlb-public-ip> above —
# never commit the real value here either.
ORACLE_DB_HOST=

# Galaxy API bearer token, used only by the local sync scripts
# (scripts/backfill.ts, scripts/incremental-sync.ts) — NOT read by the app
# itself, which always takes the token from a pasted curl/header in the
# browser instead (see GameStatsProvider) and never persists it. This is
# used verbatim as the HTTP Authorization header value (lib/galaxy-client.ts
# does not add a prefix), so include the literal "Bearer " prefix:
#   GALAXY_TOKEN=Bearer eyJhbGciOi...
# Paste a fresh one before running either script; this file stays a
# placeholder, never commit a real token.
GALAXY_TOKEN=
