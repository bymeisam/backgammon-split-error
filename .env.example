POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_dev

# Host-side connection string used by Prisma. Matches the values above;
# "localhost" is correct here because the app runs on the host and connects
# to the container's published port (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev?schema=public"
