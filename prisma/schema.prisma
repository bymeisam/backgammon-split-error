generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum DecisionKind {
  CHECKER
  CUBE
  RESIGNATION
}

enum ErrorSeverity {
  NONE
  DOUBTFUL
  ERROR
  BLUNDER
}

enum IngestStatus {
  PENDING
  INGESTING
  DONE
  FAILED
}

model Match {
  id              Int          @id @default(autoincrement())
  source          String
  sourceMatchId   String       @db.VarChar(191)
  // Match length isn't stored (dropped 2026-10-07): it's in every
  // decision's own GNU Match ID (lib/gnuMatchId.ts's effectiveMatchLength).
  // The list fields below come from Galaxy's analyses/list endpoint, not
  // from raw, and the /matches list shows them without loading raw.
  opponentName    String
  opponentCountry String
  opponentRating  Float
  opponentError   Float
  opponentScore   Int
  userError       Float
  userRating      Float
  userScore       Int
  // metadata.timestamp of the first decision (by eventId, with a populated
  // error_analysis) of the match's first game that has one — computed in
  // memory at ingest (lib/ingest.ts); no per-game copy is stored. Galaxy's
  // serve time, not a real play date: see docs/field-mapping.md.
  playedAt        DateTime?
  createdAt       DateTime     @default(now())
  ingestStatus    IngestStatus @default(PENDING)
  ingestError     String?      @db.Text

  games Game[]

  @@unique([source, sourceMatchId])
}

model SyncRun {
  id            Int       @id @default(autoincrement())
  type          String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  matchesFound  Int       @default(0)
  matchesSynced Int       @default(0)
  matchesFailed Int       @default(0)
  errors        Json?
}

model PlayerIdentity {
  id           Int     @id @default(autoincrement())
  source       String
  sourceUserId String  @db.VarChar(191)
  displayName  String
  isMe         Boolean @default(true)

  @@unique([source, sourceUserId])
}

model Game {
  id        Int   @id @default(autoincrement())
  matchId   Int
  match     Match @relation(fields: [matchId], references: [id])
  gameIndex Int
  // playedAt/userScore/opponentScore/crawfordState were dropped 2026-10-07
  // (reports/2026-10-07-column-audit.md): nothing in the app read them.
  // Each decision's own GNU Match ID carries the score, Crawford flag and
  // length at that decision (lib/gnuMatchId.ts) — see docs/field-mapping.md,
  // "Derived from raw".

  decisions Decision[]

  @@unique([matchId, gameIndex])
}

model Decision {
  id               Int           @id @default(autoincrement())
  gameId           Int
  game             Game          @relation(fields: [gameId], references: [id])
  eventId          BigInt
  userId           String        @db.VarChar(191)
  kind             DecisionKind
  countAsDecision  Boolean
  rawError         Float?
  errorSeverity    ErrorSeverity
  classification   String
  // Ordinal position among this game's own CHECKER decisions, ordered by
  // eventId ascending: 1 for the first, 2 for the second, etc., up to 4 —
  // null beyond that (deeper plies aren't a useful filter dimension). Always
  // null for CUBE/RESIGNATION kind. Computed at ingest time (lib/ingest.ts)
  // from eventId order alone — a plain per-row attribute, same category as
  // classification/kind/errorSeverity, not a derived/precomputed summary
  // table. Chosen over Galaxy-specific position-ID matching (the previous
  // "opening first move/response" approach) specifically because ordinal
  // ply position is a universal concept independent of any one data
  // source's position-encoding format — see docs/field-mapping.md's "Ply
  // number" section for the full reasoning.
  plyNumber        Int?
  // GNU Position ID (review.source_position.formatted_value) of the board
  // position this decision was made at. Populated at ingest going forward;
  // backfilled for pre-existing rows by scripts/backfill-source-position-id.ts.
  // Nullable only for migration sequencing (can't backfill 1.2M+ rows inside
  // the same ADD COLUMN) — real coverage is 100%, same as plyNumber's own
  // nullable-but-always-computable precedent. Collation pinned to
  // utf8mb4_bin: externally-sourced identifier, same reasoning as
  // RepeatedPosition.sourcePositionId (prisma/migrations/
  // 20260926153758_add_repeated_position) — see docs/field-mapping.md.
  // Replaces two previously unindexed JSON_EXTRACT call sites (lib/
  // decisionQueries.ts's findPositionOccurrences, lib/recompute-repeated-
  // positions.ts) — see reports/2026-10-02-step3-sourcepositionid-column-
  // design.md for the full index-design reasoning.
  sourcePositionId String?       @db.VarChar(191)
  // The source's complete, untouched event — never modified. Everything
  // else a decision shows (colour, event type, roll, cube, labels, move
  // notations, the engine analysis) is derived from it on demand through
  // the source's translator (lib/analysis/index.ts). The columns that used
  // to duplicate those values (color, analysedEvent, luck, luckMwc, equity,
  // mwc, cubeOwnerUserId, cubeValue, cubeConfident, roll, movePlayed,
  // moveBest, cubeActionPlayed, cubeActionBest, the five resignation
  // columns, timestamp, myTag) were dropped 2026-10-07
  // (reports/2026-10-07-column-audit.md; docs/field-mapping.md, "Derived
  // from raw"). Earlier drops: isBlunder, matchScoreBlack/matchScoreWhite/
  // crawfordState (2026-10-02).
  raw              Json

  // The user's own free-text note on this decision, if any (see
  // DecisionNote below).
  note DecisionNote?

  @@unique([gameId, eventId])
  @@index([kind, classification])
  @@index([userId])
  // Covers lib/recompute-mistake-stats.ts's groupBy WHERE (countAsDecision,
  // rawError) filter and its (classification, kind, errorSeverity) grouping
  // in one index — measured 7,417ms without it (full scan of 1.24M rows to
  // find the ~592k matching), before adding this.
  @@index([countAsDecision, rawError, kind, classification, errorSeverity])
  // Covers /mistakes' ply-based Phase filter (?phase=ply_N -> plyNumber
  // equality), which the index above doesn't help at all (it doesn't
  // include plyNumber) — measured a full ~1M-row table scan without this,
  // 5-43s depending on the rest of the filter. countAsDecision as the
  // second column (not rawError/kind/errorSeverity) is deliberate: it's the
  // one other condition /mistakes' query always applies unconditionally,
  // while kind/errorSeverity are optional — putting an always-present
  // equality column right after plyNumber keeps eventId (third column)
  // immediately reachable in every case, so the ORDER BY eventId DESC is
  // always satisfied directly from the index (a reverse range scan) instead
  // of a filesort, regardless of whether kind/errorSeverity happen to be
  // filtered. A wider index (plyNumber, countAsDecision, kind,
  // errorSeverity, eventId) was measured and rejected for exactly this
  // reason: with kind/errorSeverity in between, dropping either one from
  // the query breaks the eventId ordering guarantee, forcing an in-memory
  // sort — measured 500-950ms (vs. 1-12ms for the index below) on the 3 of
  // 5 realistic filter combinations that omit errorSeverity. rawError isn't
  // part of this index at all — it stays a cheap residual `IS NOT NULL`
  // filter on the already-narrow (~15-30k row) candidate set this index
  // produces, same reasoning kind/errorSeverity get when not explicitly
  // filtered. See docs/field-mapping.md's "Ply number" section for the
  // full before/after measurements.
  @@index([plyNumber, countAsDecision, eventId])
  // Serves findPositionOccurrences (lib/decisionQueries.ts) — equality on
  // both columns narrows ~1.26M rows to an average of ~2 and a measured
  // worst case of 10,923 (vs. the ~494k-row scans the FORCE INDEX hint this
  // replaces had to fall back on). Same column order as
  // RepeatedPosition.sourcePositionId's own unique index — same logical key
  // (sourcePositionId, errorSeverity), just not unique here since many
  // Decision rows legitimately share one. kind/countAsDecision/rawError
  // deliberately excluded: once this pair narrows to its worst-known 10,923
  // rows, applying them as residual filters costs nothing, same reasoning
  // the plyNumber index above uses for rawError. Does not help lib/
  // recompute-repeated-positions.ts's own query (filters on kind/
  // countAsDecision/rawError, not this pair) — see reports/2026-10-02-
  // step3-sourcepositionid-column-design.md.
  @@index([sourcePositionId, errorSeverity])
}

// Precomputed decision-level mistake-pattern breakdown, recomputed in full
// on every sync run (see lib/recompute-mistake-stats.ts, called from
// lib/sync.ts's runSync) — not incrementally maintained, so it stays
// self-correcting after any retroactive fix to the underlying Decision data
// (e.g. this session's rawError/playedAt corrections) rather than
// accumulating drift. category reuses DecisionKind (the same field
// Decision.kind already uses) rather than introducing a second taxonomy for
// the same cube-vs-checker-vs-resignation distinction; classification has
// no enum anywhere in this schema (Galaxy's own classification taxonomy,
// not fixed/hardcoded — see the read side in app/matches/analysis), so it
// stays a plain string here too.
model MistakeStat {
  id             Int           @id @default(autoincrement())
  classification String
  category       DecisionKind
  errorSeverity  ErrorSeverity
  decisionCount  Int
  sumAbsRawError Float
  computedAt     DateTime

  @@unique([classification, category, errorSeverity])
}

// Precomputed "faced/erred on this exact board position more than once"
// breakdown — same recompute-in-full-on-every-sync pattern as MistakeStat
// above (see lib/recompute-repeated-positions.ts, also called from
// lib/sync.ts's runSync). Only ever populated with groups whose count is
// > 1 (see the recompute function) — a row existing here always means a
// real repeat, not every distinct position. CHECKER decisions only: cube
// decisions have no comparable "same board, multiple candidate moves"
// framing (confirmed during investigation — see PROGRESS.md), so they're
// excluded entirely rather than mixed in. errorSeverity reuses the real
// ErrorSeverity enum (matching MistakeStat's own errorSeverity field, and
// for the same reason given in MistakeStat's comment: a real enum already
// exists for this, so it stays typed rather than a plain string).
//
// sourcePositionId is an externally-sourced string identifier (Galaxy's
// own GNU Position ID, via reviews[0].source_position.formatted_value —
// NOT final.gnubgid, confirmed during investigation) — pinned to a
// case-sensitive/binary collation by hand in the migration SQL, same as
// Match.sourceMatchId/PlayerIdentity.sourceUserId/Decision.userId (and the
// since-dropped Decision.cubeOwnerUserId) (see docs/field-mapping.md's "Collation for
// externally-sourced identifiers" section, updated alongside this model).
model RepeatedPosition {
  id               Int           @id @default(autoincrement())
  sourcePositionId String        @db.VarChar(191)
  classification   String
  errorSeverity    ErrorSeverity
  // Same ordinal-ply attribute as Decision.plyNumber (see its own comment),
  // carried onto this precomputed aggregate as an independent grouping
  // dimension alongside classification/errorSeverity — a real position
  // within the first 4 plies always arises at the same fixed ply across
  // every occurrence (it takes exactly that many prior checker decisions to
  // reach it), so this refines existing groups rather than fragmenting
  // them. Null for positions beyond ply 4, same as the source column.
  plyNumber        Int?
  occurrenceCount  Int
  computedAt       DateTime

  @@unique([sourcePositionId, errorSeverity, plyNumber])
  @@index([classification, errorSeverity])
  @@index([plyNumber])
}

// The user's own free-text note on one decision — the app's first
// user-authored data (everything else is ingested from Galaxy or derived
// from it). 1:1 with Decision via the unique decisionId. Written only by
// POST /api/decisions/[id]/note (gated by proxy.ts / isGalaxyEnabled()),
// read alongside every decision a board is shown for. Saving an empty note
// deletes the row rather than storing "".
//
// Keyed by the internal Decision.id, which is stable across re-syncs
// (ingest upserts decisions in place on (gameId, eventId), never deletes)
// but NOT the same between local and Oracle — scripts/notes-export.ts /
// notes-import.ts move notes between databases by the natural key
// (Match.source, Match.sourceMatchId, Game.gameIndex, Decision.eventId)
// instead. Default (RESTRICT) on delete, same as every other FK here, so a
// decision with a note can't be silently deleted out from under it.
//
// No utf8mb4_bin collation needed: decisionId is an internal Int and note
// is user text, neither an externally-sourced string identifier (see
// docs/field-mapping.md's "Collation for externally-sourced identifiers").
model DecisionNote {
  id         Int      @id @default(autoincrement())
  decisionId Int      @unique
  decision   Decision @relation(fields: [decisionId], references: [id])
  note       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
