generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum DecisionKind {
  CHECKER
  CUBE
  RESIGNATION
}

enum ErrorSeverity {
  NONE
  DOUBTFUL
  ERROR
  BLUNDER
}

enum IngestStatus {
  PENDING
  INGESTING
  DONE
  FAILED
}

model Match {
  id              Int       @id @default(autoincrement())
  source          String
  sourceMatchId   String @db.VarChar(191)
  matchLength     Int?
  opponentName    String
  opponentCountry String
  opponentRating  Float
  opponentError   Float
  opponentScore   Int
  userError       Float
  userRating      Float
  userScore       Int
  playedAt        DateTime?
  createdAt       DateTime  @default(now())
  ingestStatus    IngestStatus @default(PENDING)
  ingestError     String?      @db.Text

  games Game[]

  @@unique([source, sourceMatchId])
}

model SyncRun {
  id            Int       @id @default(autoincrement())
  type          String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  matchesFound  Int       @default(0)
  matchesSynced Int       @default(0)
  matchesFailed Int       @default(0)
  errors        Json?
}

model PlayerIdentity {
  id           Int     @id @default(autoincrement())
  source       String
  sourceUserId String @db.VarChar(191)
  displayName  String
  isMe         Boolean @default(true)

  @@unique([source, sourceUserId])
}

model Game {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     Match     @relation(fields: [matchId], references: [id])
  gameIndex Int
  playedAt  DateTime?

  decisions Decision[]

  @@unique([matchId, gameIndex])
}

model Decision {
  id              Int           @id @default(autoincrement())
  gameId          Int
  game            Game          @relation(fields: [gameId], references: [id])
  eventId         BigInt
  userId          String        @db.VarChar(191)
  color           String
  kind            DecisionKind
  analysedEvent   String
  countAsDecision Boolean
  rawError        Float
  errorSeverity   ErrorSeverity
  isBlunder       Boolean
  luck            Float?
  luckMwc         Float?
  equity          Float?
  mwc             Float?
  classification  String
  matchScoreBlack Int?
  matchScoreWhite Int?
  crawfordState   String
  cubeOwnerUserId String?       @db.VarChar(191)
  notationPlayed  String?
  notationBest    String?
  cubeDetail      String?
  resignError     Float?
  shouldResign    Boolean?
  resignationType String?
  equityBefore    Float?
  equityAfter     Float?
  timestamp       DateTime
  myTag           String?
  raw             Json

  @@unique([gameId, eventId])
  @@index([kind, classification])
  @@index([userId])
}
