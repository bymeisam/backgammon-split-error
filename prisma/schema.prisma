generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DecisionKind {
  CHECKER
  CUBE
}

enum ErrorSeverity {
  NONE
  DOUBTFUL
  ERROR
  BLUNDER
}

model Match {
  id              Int       @id @default(autoincrement())
  source          String
  sourceMatchId   String
  matchLength     Int?
  opponentName    String
  opponentCountry String
  opponentRating  Float
  opponentError   Float
  opponentScore   Int
  userError       Float
  userRating      Float
  userScore       Int
  playedAt        DateTime?
  createdAt       DateTime  @default(now())

  games Game[]

  @@unique([source, sourceMatchId])
}

model PlayerIdentity {
  id           Int     @id @default(autoincrement())
  source       String
  sourceUserId String
  displayName  String
  isMe         Boolean @default(true)

  @@unique([source, sourceUserId])
}

model Game {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     Match     @relation(fields: [matchId], references: [id])
  gameIndex Int
  playedAt  DateTime?

  decisions Decision[]

  @@unique([matchId, gameIndex])
}

model Decision {
  id              Int           @id @default(autoincrement())
  gameId          Int
  game            Game          @relation(fields: [gameId], references: [id])
  eventId         BigInt
  userId          String
  color           String
  kind            DecisionKind
  analysedEvent   String
  countAsDecision Boolean
  rawError        Float
  errorSeverity   ErrorSeverity
  isBlunder       Boolean
  luck            Float?
  luckMwc         Float?
  equity          Float?
  mwc             Float?
  classification  String
  matchScoreBlack Int
  matchScoreWhite Int
  crawfordState   String
  cubeOwnerUserId String?
  notationPlayed  String?
  notationBest    String?
  cubeDetail      String?
  timestamp       DateTime
  myTag           String?
  raw             Json

  @@unique([gameId, eventId])
  @@index([kind, classification])
  @@index([userId])
}
