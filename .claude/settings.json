{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "autoCompactWindow": 350000,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/omp-queue-check.mjs\""
          }
        ]
      }
    ]
  }
}
